// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  OWNER
}

enum OrderType {
  DELIVERY
  PICKUP
  CATERING
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
  REFUNDED
}

enum MenuItemType {
  PLATE
  A_LA_CARTE
  MEAL_PLAN
  CATERING
  DESSERT
  SIDE
  OTHER
}

enum CateringStatus {
  NEW
  REVIEWING
  QUOTED
  APPROVED
  DEPOSIT_DUE
  DEPOSIT_PAID
  COMPLETED
  CANCELLED
}

enum ApprovalStatus{
  PENDING
  APPROVED
  DENIED
}

enum ServiceRequestType {
  CATERING
  PERSONAL_CHEF
}

enum WeeklyMenuStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum WeeklyMealPlanOptionType {
  SPICE_LEVEL
  PROTEIN_SUBSTITUTION
}

enum PaymentProvider {
  SQUARE
  PAYPAL
  MANUAL
}

enum PaymentPurpose {
  ORDER_TOTAL
  SERVICE_DEPOSIT
  SERVICE_FINAL_BALANCE
  REFUND
  RETRY
}

enum PaymentWebsiteStatus {
  CREATED
  PENDING
  REQUIRES_ACTION
  PAID
  FAILED
  CANCELLED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentEventProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}


model CateringRequest {
  id              String         @id @default(cuid())

  userId          String?
  user            User?          @relation(fields: [userId], references: [id])

  name            String
  email           String
  phone           String?

  eventDate       DateTime?
  eventType       String?
  guestCount      Int?
  location        String?

  requestedMenu   String?
  allergyNotes    String?
  specialRequests String?

  status          CateringStatus @default(NEW)

  estimatedTotal  Decimal?       @db.Decimal(10, 2)
  depositAmount   Decimal?       @db.Decimal(10, 2)
  depositPaidAt   DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  approvalStatus ApprovalStatus @default(PENDING)
  approvalNote   String?
  approvedAt     DateTime?
  deniedAt       DateTime?
  requestType ServiceRequestType @default(CATERING)
  paymentAttempts PaymentAttempt[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  allergens     UserAllergen[]
  phone         String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  deliveryNotes String?

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  cateringRequests CateringRequest[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MenuCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  sortOrder Int        @default(0)
  items     MenuItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  available   Boolean  @default(true)
  seasonal    Boolean  @default(false)
  imageUrl    String?
  
  type                        MenuItemType @default(PLATE)
  requiresApproval            Boolean      @default(false)
  customerInstructionsEnabled Boolean      @default(false)

  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id])

  orderItems    OrderItem[]

  allergens     MenuItemAllergen[]
  optionGroups  MenuItemOptionGroup[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archived Boolean @default(false)
}

model GalleryImage {
  id        String   @id @default(cuid())
  src       String
  alt       String
  title     String
  category  String
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, sortOrder])
  @@index([sortOrder])
}

model Allergen {
  id                      String   @id @default(cuid())
  name                    String   @unique
  users                   UserAllergen[]
  menuItems               MenuItemAllergen[]
  weeklyMealPlanOfferings AllergenWeeklyMealPlanOffering[]

  createdAt DateTime @default(now())
}

model MenuItemAllergen {
  id          String    @id @default(cuid())

  menuItemId  String
  allergenId  String

  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  allergen    Allergen  @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, allergenId])
}

model MenuItemOptionGroup {
  id          String   @id @default(cuid())

  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  name        String
  required    Boolean  @default(false)
  multiple    Boolean  @default(false)

  choices     MenuItemOptionChoice[]

  createdAt   DateTime @default(now())
}

model MenuItemOptionChoice {
  id              String              @id @default(cuid())

  optionGroupId   String
  optionGroup     MenuItemOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  dietaryInfo     String?
  imageUrl        String?
  requestOnly     Boolean             @default(false)

  priceDelta      Decimal             @db.Decimal(10, 2) @default(0)

  createdAt       DateTime            @default(now())
}

model WeeklyMenuPeriod {
  id               String           @id @default(cuid())
  label            String
  startDate        DateTime
  endDate          DateTime
  orderCutoffAt    DateTime?
  orderingOpenAt   DateTime?
  lateFeeStartsAt  DateTime?
  orderingClosesAt DateTime?
  fixedFulfillmentAt DateTime?
  customerSchedulingEnabled Boolean?
  deliveryWindowLabel String?
  fulfillmentNotes String?
  status           WeeklyMenuStatus @default(DRAFT)

  capacity     Int @default(10)
  ordersPlaced Int @default(0)

  cloneSourceId String?
  cloneSource   WeeklyMenuPeriod?  @relation("WeeklyMenuPeriodClones", fields: [cloneSourceId], references: [id], onDelete: SetNull)
  clones        WeeklyMenuPeriod[] @relation("WeeklyMenuPeriodClones")

  packages        WeeklyMealPlanPackage[]
  offerings       WeeklyMealPlanOffering[]
  orderSelections OrderWeeklyMealPlanSelection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startDate, endDate])
}

model WeeklyMealPlanPackage {
  id          String @id @default(cuid())
  periodId    String
  period      WeeklyMenuPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  name         String
  days         Int
  mealsPerDay  Int
  price        Decimal @db.Decimal(10, 2)
  available    Boolean @default(true)
  requiresChefApproval Boolean @default(false)
  isSeasonal   Boolean @default(false)
  mealSlotLabels Json?
  displayOrder Int @default(0)
  notes        String?

  orderSelections OrderWeeklyMealPlanSelection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, days, mealsPerDay])
  @@index([periodId, available, displayOrder])
}

model WeeklyMealPlanOffering {
  id          String @id @default(cuid())
  periodId    String
  period      WeeklyMenuPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  name         String
  description  String
  imageUrl     String?
  dietaryInfo  String?
  available    Boolean @default(true)
  breakfastOnly Boolean @default(false)
  displayOrder Int @default(0)

  allergens       AllergenWeeklyMealPlanOffering[]
  options         WeeklyMealPlanAllowedOption[]
  orderSelections OrderWeeklyMealPlanSelection[]
  orderSlotSelections OrderWeeklyMealPlanSlotSelection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, name])
  @@index([periodId, available, displayOrder])
}

model AllergenWeeklyMealPlanOffering {
  id         String @id @default(cuid())
  offeringId String
  allergenId String

  offering WeeklyMealPlanOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  allergen Allergen               @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@unique([offeringId, allergenId])
}

model WeeklyMealPlanAllowedOption {
  id         String @id @default(cuid())
  offeringId String
  offering   WeeklyMealPlanOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  optionType       WeeklyMealPlanOptionType
  name             String
  description      String?
  dietaryInfo      String?
  priceDelta       Decimal @db.Decimal(10, 2) @default(0)
  requestOnly      Boolean @default(false)
  requiresApproval Boolean @default(false)
  available        Boolean @default(true)
  displayOrder     Int @default(0)

  orderSlotOptionSelections OrderWeeklyMealPlanSlotOptionSelection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([offeringId, optionType, name])
  @@index([offeringId, optionType, displayOrder])
}

model Order {
  id                       String      @id @default(cuid())
  userId                   String?
  user                     User?       @relation(fields: [userId], references: [id])

  deliveryName         String?
  deliveryPhone        String?
  deliveryAddressLine1 String?
  deliveryAddressLine2 String?
  deliveryCity         String?
  deliveryState        String?
  deliveryPostalCode   String?
  deliveryNotes        String?

  customerName             String
  customerEmail            String
  customerPhone            String?

  orderType                OrderType
  status                   OrderStatus @default(PENDING)

  requestedDateTime        DateTime?
  allergyNotes             String?
  substitutionPreference   String?

  allergenAcknowledged     Boolean     @default(false)
  allergenAcknowledgedAt   DateTime?
  
  subtotal                 Decimal     @db.Decimal(10, 2)
  deliveryFee              Decimal     @db.Decimal(10, 2) @default(0)
  lateFee                  Decimal     @db.Decimal(10, 2) @default(0)
  tipAmount                Decimal     @db.Decimal(10, 2) @default(0)
  total                    Decimal     @db.Decimal(10, 2)

  payByDate                DateTime?
  paidAt                   DateTime?
  paymentProvider          String?
  paymentStatus            String?
  paymentAttempts          PaymentAttempt[]

  items                    OrderItem[]
  statusHistory            OrderStatusHistory[]

  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  approvalStatus ApprovalStatus @default(PENDING)
  approvalNote   String?
  approvedAt     DateTime?
  deniedAt       DateTime?
}

model PaymentAttempt {
  id                     String               @id @default(cuid())
  provider               PaymentProvider
  providerPaymentId      String?
  providerOrderId        String?
  providerReceiptUrl     String?              @db.Text
  receiptReference       String?
  providerStatus         String?
  websiteStatus          PaymentWebsiteStatus @default(CREATED)
  paymentPurpose         PaymentPurpose
  amountCents            Int                  @db.UnsignedInt
  tipCents               Int                  @default(0) @db.UnsignedInt
  currency               String               @default("USD") @db.Char(3)
  idempotencyKey         String               @unique
  orderId                String?
  order                  Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  serviceRequestId       String?
  serviceRequest         CateringRequest?     @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  parentPaymentId        String?
  parentPayment          PaymentAttempt?      @relation("PaymentAttemptLineage", fields: [parentPaymentId], references: [id], onDelete: SetNull)
  childPayments          PaymentAttempt[]     @relation("PaymentAttemptLineage")
  expiresAt              DateTime?
  paidAt                 DateTime?
  failedAt               DateTime?
  cancelledAt            DateTime?
  refundedAt             DateTime?
  metadata               Json?
  webhookEvents          PaymentWebhookEvent[]
  retryTokens            PaymentRetryToken[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([orderId, createdAt])
  @@index([serviceRequestId, createdAt])
  @@index([provider, providerStatus])
  @@index([provider, providerOrderId])
  @@index([websiteStatus, expiresAt])
  @@index([parentPaymentId])
  @@unique([provider, providerPaymentId])
}

model PaymentWebhookEvent {
  id                       String                       @id @default(cuid())
  provider                 PaymentProvider
  eventId                  String
  eventType                String
  paymentAttemptId         String?
  paymentAttempt           PaymentAttempt?              @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  processingStatus         PaymentEventProcessingStatus @default(RECEIVED)
  payloadHash              String?                      @db.Char(64)
  rawSummary               Json?
  sanitizedProcessingError String?                      @db.Text
  receivedAt               DateTime                     @default(now())
  processedAt              DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  @@unique([provider, eventId])
  @@index([paymentAttemptId, receivedAt])
  @@index([processingStatus, receivedAt])
}

model PaymentRetryToken {
  id               String         @id @default(cuid())
  paymentAttemptId String
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)
  tokenHash        String         @unique @db.Char(64)
  expiresAt        DateTime
  consumedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime       @default(now())

  @@index([paymentAttemptId, expiresAt])
  @@index([expiresAt, consumedAt, revokedAt])
}

model OrderItem {
  id         String   @id @default(cuid())

  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  name       String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  lineTotal  Decimal  @db.Decimal(10, 2)

  notes      String?

  allergenAcknowledged     Boolean   @default(false)
  allergenAcknowledgedAt   DateTime?
  allergenConflictSnapshot Json?

  weeklyMealPlanSelection OrderWeeklyMealPlanSelection?
}

model OrderWeeklyMealPlanSelection {
  id          String   @id @default(cuid())
  orderItemId String   @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  weeklyMenuPeriodId       String?
  weeklyMealPlanPackageId  String?
  weeklyMealPlanOfferingId String?

  weeklyMenuPeriod       WeeklyMenuPeriod? @relation(fields: [weeklyMenuPeriodId], references: [id], onDelete: SetNull)
  weeklyMealPlanPackage  WeeklyMealPlanPackage? @relation(fields: [weeklyMealPlanPackageId], references: [id], onDelete: SetNull)
  weeklyMealPlanOffering WeeklyMealPlanOffering? @relation(fields: [weeklyMealPlanOfferingId], references: [id], onDelete: SetNull)

  periodLabel         String
  packageName         String
  packageDays         Int
  packageMealsPerDay  Int
  packagePrice        Decimal @db.Decimal(10, 2)
  packageRequiresChefApproval Boolean @default(false)
  packageIsSeasonal   Boolean @default(false)
  offeringName        String
  spiceLevel          String?
  proteinSubstitution String?
  requestOnly         Boolean @default(false)
  requiresApproval    Boolean @default(false)
  priceDelta          Decimal @db.Decimal(10, 2) @default(0)

  mealSlots OrderWeeklyMealPlanSlotSelection[]

  createdAt DateTime @default(now())
}

model OrderWeeklyMealPlanSlotSelection {
  id String @id @default(cuid())

  orderWeeklyMealPlanSelectionId String
  orderWeeklyMealPlanSelection   OrderWeeklyMealPlanSelection @relation(fields: [orderWeeklyMealPlanSelectionId], references: [id], onDelete: Cascade)

  weeklyMealPlanOfferingId String?
  weeklyMealPlanOffering   WeeklyMealPlanOffering? @relation(fields: [weeklyMealPlanOfferingId], references: [id], onDelete: SetNull)

  dayNumber  Int
  mealNumber Int
  mealLabel  String?

  offeringName        String
  offeringDescription String?
  dietaryInfo         String?

  selectedOptions OrderWeeklyMealPlanSlotOptionSelection[]

  createdAt DateTime @default(now())

  @@unique([orderWeeklyMealPlanSelectionId, dayNumber, mealNumber])
  @@index([weeklyMealPlanOfferingId])
}

model OrderWeeklyMealPlanSlotOptionSelection {
  id String @id @default(cuid())

  orderWeeklyMealPlanSlotSelectionId String
  orderWeeklyMealPlanSlotSelection   OrderWeeklyMealPlanSlotSelection @relation(fields: [orderWeeklyMealPlanSlotSelectionId], references: [id], onDelete: Cascade)

  weeklyMealPlanAllowedOptionId String?
  weeklyMealPlanAllowedOption   WeeklyMealPlanAllowedOption? @relation(fields: [weeklyMealPlanAllowedOptionId], references: [id], onDelete: SetNull)

  optionType        WeeklyMealPlanOptionType
  optionName        String
  optionDescription String?
  dietaryInfo       String?
  priceDelta        Decimal @db.Decimal(10, 2) @default(0)
  requestOnly       Boolean @default(false)
  requiresApproval  Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([orderWeeklyMealPlanSlotSelectionId, optionType])
  @@index([weeklyMealPlanAllowedOptionId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())

  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status    OrderStatus
  note      String?

  createdAt DateTime    @default(now())
}

model BusinessSettings {
  id                       String   @id @default(cuid())

  deliveryFee              Decimal  @db.Decimal(10, 2) @default(10)
  lateFee                  Decimal  @db.Decimal(10, 2) @default(10)
  cateringDepositPercent   Int      @default(50)

  orderCutoffDay           Int      @default(4)
  orderCutoffHour          Int      @default(17)
  orderCutoffMinute        Int      @default(0)

  noWeekendOrdering        Boolean  @default(true)
  deliveryArea             String?  @default("Greater Atlanta area")

  checkoutCustomerSchedulingEnabled Boolean @default(false)
  checkoutFixedFulfillmentDay       Int     @default(0)
  checkoutFixedFulfillmentHour      Int?
  checkoutFixedFulfillmentMinute    Int?
  checkoutFixedFulfillmentMessage   String? @default("Orders are fulfilled on Sunday. You will be notified when your order is scheduled.")

  weeklyCustomerSchedulingEnabled Boolean @default(false)
  weeklyOrderingOpenDay           Int     @default(3)
  weeklyOrderingOpenHour          Int     @default(0)
  weeklyOrderingOpenMinute        Int     @default(0)
  weeklyLateFeeStartDay           Int     @default(5)
  weeklyLateFeeStartHour          Int     @default(17)
  weeklyLateFeeStartMinute        Int     @default(0)
  weeklyOrderingCloseDay          Int     @default(5)
  weeklyOrderingCloseHour         Int     @default(22)
  weeklyOrderingCloseMinute       Int     @default(0)
  weeklyFixedFulfillmentDay       Int     @default(0)
  weeklyFixedFulfillmentHour      Int?
  weeklyFixedFulfillmentMinute    Int?
  weeklyFixedFulfillmentMessage   String? @default("Weekly meal plan orders are delivered on Sunday. You will be notified when delivery is scheduled.")

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model UserAllergen {
  id         String   @id @default(cuid())

  userId     String
  allergenId String

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([userId, allergenId])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String?
  actorUserId String?
  actorEmail  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}
