{
  "name": "chef-rahs-twisted-kitchen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run prisma:generate && npx prisma migrate deploy",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "check": "npm run lint && npm run prisma:generate && npm run typecheck && npm run build",
    "env:check": "node scripts/check-production-env.mjs",
    "qa:square-refund-status": "tsx scripts/qa-square-refund-status.ts",
    "payment:recover-affected-refund": "node --conditions=react-server --import tsx scripts/reconcile-affected-square-refund.ts",
    "owner:promote": "tsx prisma/promote-admin.ts --owner",
    "admin:promote": "tsx prisma/promote-admin.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-demo": "tsx prisma/seed-demo-data.ts"
  },
  "overrides": {
    "@prisma/config@7.9.1": {
      "deepmerge-ts": "8.0.2"
    },
    "@babel/core": "7.29.6",
    "@hono/node-server": "1.19.13",
    "brace-expansion@^5.0.0": "5.0.9",
    "minimatch@^3.1.0": "10.2.5",
    "postcss": {
      ".": "8.5.25",
      "nanoid": "3.3.18"
    },
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.14.0",
    "mariadb": "^3.5.3",
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "^6.4.0",
    "resend": "^6.12.4",
    "server-only": "^0.0.1",
    "square": "^45.0.1",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.1": true,
    "prisma@7.9.1": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.11.1": true
  }
}
